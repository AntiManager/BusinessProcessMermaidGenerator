{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "instructions": [
    ".memory/project_brief.md",
    ".memory/active_context.md",
    ".memory/progress.md",
    ".memory/tech_context.md",
    ".memory/system_patterns.md"
  ],
  "permission": {
    "bash": "allow",
    "read": {
      ".env*": "deny",
      "**/.env*": "deny",
      "_private/**": "deny",
      "**/_private/**": "deny",
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": {
      ".env*": "ask",
      "**/.env*": "ask",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "node_modules/**": "deny",
      "**/node_modules/**": "deny",
      "_private/**": "deny",
      "**/_private/**": "deny",
      "*.py": "allow",
      "*.md": "allow",
      "*.yaml": "allow",
      "requirements.txt": "allow",
      "*": "ask"
    },
    "task": "allow"
  },
  "snapshot": false
}
